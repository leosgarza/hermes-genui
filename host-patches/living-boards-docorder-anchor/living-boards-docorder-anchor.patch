+describe('anchor winner: document order, not mount order', () => {
+  // Owner-reported regression (2026-11-21, long Newspaper session): the
+  // transcript lazy-mounts messages as the reader scrolls, so an EARLIER
+  // paste of the same tag can mount AFTER the latest one. Under the
+  // newest-mount rule the card flipped up to the old reply and the latest
+  // occurrence showed only a marker ("board stranded at an earlier go").
+  // The winner is the occurrence LAST IN DOCUMENT ORDER; the mount clock
+  // only decides when a caller gives no position at all.
+  const transcriptRoot = () => {
+    const root = document.createElement('div')
+    document.body.appendChild(root)
+
+    return root
+  }
+
+  const pasteAt = (root: HTMLElement) => {
+    const el = document.createElement('div')
+    root.appendChild(el)
+
+    return el
+  }
+
+  it('the latest reply that mounted first keeps the card when an earlier paste mounts after it', () => {
+    const registry = createAnchorRegistry()
+    const root = transcriptRoot()
+    const early = pasteAt(root)
+    const late = pasteAt(root)
+    const tEarly = mount()
+    const tLate = mount()
+
+    // The thread loads at the bottom: the latest occurrence mounts first…
+    registry.register('blocks:x', tLate, late)
+    // …then the reader scrolls up and the earlier occurrence mounts second.
+    registry.register('blocks:x', tEarly, early)
+
+    expect(registry.isWinner('blocks:x', tLate)).toBe(true)
+    expect(registry.isWinner('blocks:x', tEarly)).toBe(false)
+
+    root.remove()
+  })
+
+  it('handoff after the winner leaves goes to the document-last survivor, not the last mount', () => {
+    const registry = createAnchorRegistry()
+    const root = transcriptRoot()
+    const early = pasteAt(root)
+    const middle = pasteAt(root)
+    const late = pasteAt(root)
+    const tEarly = mount()
+    const tMiddle = mount()
+    const tLate = mount()
+
+    // Mount order matches document order…
+    registry.register('blocks:x', tEarly, early)
+    registry.register('blocks:x', tMiddle, middle)
+    registry.register('blocks:x', tLate, late)
+
+    // …then EARLY re-mounts last (a paginated scroll-up) so the mount clock
+    // sits on early while the document still ends at late.
+    registry.release('blocks:x', tEarly)
+    registry.register('blocks:x', tEarly, early)
+
+    expect(registry.isWinner('blocks:x', tLate)).toBe(true)
+
+    registry.release('blocks:x', tLate)
+
+    // A mount-order rule now picks early (highest mount clock); the document
+    // rule must pick middle — the survivor last in the transcript.
+    expect(registry.isWinner('blocks:x', tMiddle)).toBe(true)
+    expect(registry.isWinner('blocks:x', tEarly)).toBe(false)
+
+    root.remove()
+  })
+
+  it('a seat whose DOM node was swapped (marker <-> card, no remount) keeps its document position', () => {
+    // A winner flip re-renders the entry under a different root element. If
+    // the seat kept the now-detached node, position comparison fails over to
+    // the mount clock — exactly the flip that strands the board. The entry
+    // syncs its seat element each commit via setSeatEl.
+    const registry = createAnchorRegistry()
+    const root = transcriptRoot()
+    const early = pasteAt(root)
+    const lateOld = pasteAt(root)
+    const tEarly = mount()
+    const tLate = mount()
+
+    registry.register('blocks:x', tLate, lateOld)
+    registry.register('blocks:x', tEarly, early)
+
+    expect(registry.isWinner('blocks:x', tLate)).toBe(true)
+
+    // The late entry's root node is replaced in place (same document slot).
+    const lateNew = document.createElement('div')
+    root.replaceChild(lateNew, lateOld)
+    registry.setSeatEl('blocks:x', tLate, lateNew)
+
+    expect(registry.isWinner('blocks:x', tLate)).toBe(true)
+
+    // And without the sync, a stale detached node must not beat a live one
+    // that is earlier in the document: re-register with the swapped node.
+    registry.release('blocks:x', tLate)
+    registry.release('blocks:x', tEarly)
+    registry.register('blocks:x', tLate, lateNew)
+    registry.register('blocks:x', tEarly, early)
+
+    expect(registry.isWinner('blocks:x', tLate)).toBe(true)
+
+    root.remove()
+  })
+})
