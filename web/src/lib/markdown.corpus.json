    "inputs": [
     {
      "name": "rate",
      "label": "Rate",
      "value": 10,
      "unit": "%"
     }
    ],
    "values": {
     "start": 100
    },
    "view": {
     "piles": [
      {
       "name": "Simple",
       "formula": "start * (1 + rate / 100 * years)"
      },
      {
       "name": "Compound",
       "formula": "start * (1 + rate / 100) ^ years"
      },
      {
       "name": "Helper",
       "formula": "balance(start, rate, years, years)"
      }
     ]
    }
   }
  ],
  "expected": "**Savings**\nWith Rate 10%:\n| years | Simple | Compound | Helper |\n| --- | --- | --- | --- |\n| 0 | 100 ₹ | 100 ₹ | – |\n| 8 | 180 ₹ | 214 ₹ | – |\n| 15 | 250 ₹ | 418 ₹ | – |\n| 23 | 330 ₹ | 895 ₹ | – |\n| 30 | 400 ₹ | 1,745 ₹ | – |"
